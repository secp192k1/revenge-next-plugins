{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"types": ["@revenge-mod/types", "@revenge-mod/types/hidden"]
	},
	"include": ["plugins", "types"],
	"exclude": ["plugins/*/build"]
}
